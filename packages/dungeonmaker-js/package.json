{
  "name": "dungeonmaker-js",
  "version": "0.0.2",
  "description": "Procedural dungeon generator: an unofficial WebAssembly port of DungeonMaker 2.05",
  "keywords": [
    "dungeon",
    "procedural-generation",
    "roguelike",
    "wasm",
    "webassembly",
    "map"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Wolfger Schramm <wolfger@spearwolf.de>",
  "homepage": "https://github.com/spearwolf/dungeonmaker.js",
  "bugs": "https://github.com/spearwolf/dungeonmaker.js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spearwolf/dungeonmaker.js.git",
    "directory": "packages/dungeonmaker-js"
  },
  "type": "module",
  "sideEffects": [
    "./dist/worker.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./design.schema.json": "./design.schema.json",
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./worker": {
      "default": "./dist/worker.js"
    },
    "./dungeonmaker.wasm": "./wasm/dungeonmaker.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "design.schema.json",
    "wasm/dungeonmaker.js",
    "wasm/dungeonmaker.wasm",
    "wasm/BUILD-INFO.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "generate": "pnpm run build && node ../../scripts/generate-design-artifacts.mjs",
    "test": "vitest run",
    "test:browser": "pnpm run build && tsc -p test/browser/tsconfig.json && vitest run -c vitest.browser.config.ts",
    "prepack": "node ../../scripts/copy-legal.mjs && pnpm run build"
  },
  "dependencies": {
    "typebox": "^1.4.3"
  }
}
