{
  "name": "dungeonmaker-js-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "lint": "biome ci . && node scripts/check-spdx.mjs",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "check:package": "publint --strict packages/dungeonmaker-js && pnpm --filter dungeonmaker-js exec attw --pack . --profile esm-only --exclude-entrypoints ./worker ./dungeonmaker.wasm ./design.schema.json",
    "size": "node scripts/check-size.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "bundler:smoke": "node scripts/bundler-smoke.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "semver": "7.8.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
